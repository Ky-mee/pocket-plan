# Production: URL of your deployed AI proxy (see worker/README.md).
# This is safe to ship: it holds no secret.
GEMINI_PROXY_URL=https://pocketplan-ai.YOUR-SUBDOMAIN.workers.dev

# Local development ONLY, used when GEMINI_PROXY_URL is empty.
# Never put a real key here for a build you publish.
# GEMINI_API_KEY=your_gemini_api_key_here
